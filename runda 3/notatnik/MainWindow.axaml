<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:notatnik"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
        x:Class="notatnik.MainWindow"
        Title="Notatnik"
        Width="800" Height="600"
        MinWidth="500" MinHeight="400">

    <Grid RowDefinitions="Auto,Auto,*" Margin="16">

        <!-- Tytuł -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Tytuł:" Margin="0,0,0,4" FontWeight="SemiBold"/>
            <TextBox x:Name="TitleBox" PlaceholderText="Wpisz tytuł notatki..." />
        </StackPanel>

        <!-- Treść + przycisk -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="Treść:" Margin="0,0,0,4" FontWeight="SemiBold"/>
            <TextBox x:Name="ContentBox"
                     PlaceholderText="Wpisz treść notatki..."
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Height="120" />
            <Button x:Name="SaveButton"
                    Content="💾  Zapisz notatkę"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Margin="0,8,0,0"
                    Classes="accent"
                    Click="SaveButton_Click" />
        </StackPanel>

        <!-- Lista zapisanych notatek -->
        <DockPanel Grid.Row="2">
            <TextBlock DockPanel.Dock="Top" Text="Zapisane notatki:" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <ListBox x:Name="NotesList"
                     SelectionMode="Single">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="local:NoteItem">
                        <StackPanel Margin="4">
                            <TextBlock Text="{Binding Header}" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text="{Binding Preview}" Foreground="Gray" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

    </Grid>
</Window>
